<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ============
         LOG PATTERNS
         ============ -->
    <property name="LOG_PATH" value="logs"/>
    <property name="LOG_FILE" value="${LOG_PATH}/application.log"/>

    <!-- ============
         CONSOLE LOGS
         ============ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <!-- ===================
         FILE APPENDER (JSON)
         =================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>

        <!-- DAILY + SIZE BASED ROLLING -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- app.log → app-2025-11-25.1.gz -->
            <fileNamePattern>${LOG_PATH}/application-%d{yyyy-MM-dd}.%i.gz</fileNamePattern>

            <!-- Max file size before rollover -->
            <maxFileSize>10MB</maxFileSize>

            <!-- Keep logs for 30 days -->
            <maxHistory>30</maxHistory>

            <!-- Total size cap -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==================
         CUSTOM LOG LEVELS
         ================== -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.mongodb.driver" level="DEBUG"/> <!-- Mongo driver debug -->
    <logger name="com.xworkz" level="DEBUG"/> <!-- your project package -->

    <!-- ============
         ROOT LOGGER
         ============ -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
